# Copy to .env and set the URL for your backend. Never put AWS secrets here.
REACT_APP_API_URL=http://localhost:8000
# Backend endpoint that returns a signed upload URL; see docs/uploads.md.
REACT_APP_UPLOAD_SIGNING_PATH=/uploads/presign/
REACT_APP_OPEN_WEATHER_URL=https://api.openweathermap.org
REACT_APP_OPEN_WEATHER_KEY=
